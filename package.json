{
  "name": "pi-gmi-cloud",
  "version": "0.1.0",
  "description": "GMI Cloud provider for pi with dynamic model discovery",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "gmi-cloud",
    "gmi",
    "llm",
    "provider",
    "coding-agent"
  ],
  "license": "MIT",
  "author": "Xuanwo",
  "type": "module",
  "homepage": "https://github.com/Xuanwo/pi-gmi-cloud#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xuanwo/pi-gmi-cloud.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "bugs": {
    "url": "https://github.com/Xuanwo/pi-gmi-cloud/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test 'tests/*.test.ts'",
    "pack:check": "node scripts/check-package.mjs",
    "check": "npm run typecheck && npm run test && npm run pack:check"
  },
  "pi": {
    "extensions": [
      "./extensions/gmi-cloud.ts"
    ]
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
